{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skills manifest",
  "description": "Generated index of every skill and collection (skills/manifest.json). Produced by scripts/build-collections.py; do not edit by hand. Skill source of truth is the SKILL.md frontmatter.",
  "type": "object",
  "required": ["version", "generated_by", "skills", "collections"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$" },
    "generated_by": { "type": "string" },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "category", "path", "description", "version", "related", "files"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 64 },
          "category": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "path": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$" },
          "related": { "type": "array", "items": { "type": "string" } },
          "files": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "collections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description", "when_to_use", "skills"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "when_to_use": { "type": "string" },
          "skills": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    }
  }
}
